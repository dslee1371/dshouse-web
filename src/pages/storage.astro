---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
---

<BaseLayout title="예원교회 | 이동수하우스" description="예배자료를 작성하고 OCI 버킷에 저장·불러옵니다.">
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <h1 class="text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">예원교회</span>
    </h1>
    <p class="mt-4 max-w-2xl text-gray-600 dark:text-gray-300">
      예배자료를 입력하면 PPT 생성용 텍스트로 정리되고, 버킷에 저장·불러올 수 있습니다.
    </p>
  </section>

  <section class="mt-8">
    <div id="token-gate" class="card rounded-2xl max-w-md">
      <h2 class="font-semibold">토큰 입력</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">사용하려면 공유 토큰이 필요합니다.</p>
      <div class="mt-4 flex gap-2">
        <input id="token-input" type="password" placeholder="토큰"
               class="flex-1 rounded-lg border px-3 py-2 text-sm bg-white/80 dark:bg-white/5 dark:border-white/20" />
        <button id="token-submit" class="btn btn-primary">입장</button>
      </div>
      <p id="token-error" class="mt-2 text-sm text-red-500 hidden">토큰이 올바르지 않습니다.</p>
    </div>

    <div id="app-wrap" class="hidden grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
      <!-- 왼쪽: 상태 / 파일명 / 저장된 자료 -->
      <aside class="space-y-6">
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">제출 상태</h2>
          <div id="statusList" class="mt-3 space-y-2 text-sm"></div>
        </div>
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">검증 리포트</h2>
          <ul id="issues" class="mt-3 space-y-2 text-sm"></ul>
        </div>
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">파일명</h2>
          <div id="fileName" class="mt-2 text-sm font-mono text-gray-600 dark:text-gray-300"></div>
        </div>
        <div class="card rounded-2xl">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold">저장된 자료</h2>
            <button id="refreshBtn" class="text-xs underline text-gray-500">새로고침</button>
          </div>
          <ul id="savedList" class="mt-3 space-y-2 text-sm"></ul>
        </div>
      </aside>

      <!-- 가운데: 입력 폼 -->
      <main>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold">이번 주 예배자료</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">담당자별 입력을 모아 PPT 생성용 자료 파일을 만듭니다.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="saveBtn" type="button" class="btn btn-primary text-xs px-3 py-2">저장하기</button>
          </div>
        </div>
        <p id="saveStatus" class="mt-2 text-sm text-gray-500"></p>

        <form id="materialForm" class="mt-6 space-y-6">
          <section class="card rounded-2xl">
            <h3 class="font-semibold">예배 정보</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div>
                <label for="serviceDate" class="block text-xs text-gray-500 mb-1">예배 날짜</label>
                <input id="serviceDate" type="date" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="serviceType" class="block text-xs text-gray-500 mb-1">예배 종류</label>
                <select id="serviceType" class="w-full border rounded-lg px-3 py-2 text-sm">
                  <option>주일오전예배</option>
                  <option>수요예배</option>
                  <option>금요기도회</option>
                  <option>주일학교</option>
                </select>
              </div>
            </div>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">찬양팀</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div class="md:col-span-2">
                <label for="praiseMain" class="block text-xs text-gray-500 mb-1">찬양 (한 줄에 한 곡씩)</label>
                <textarea id="praiseMain" rows="4" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
                <p class="mt-1 text-xs text-gray-500">자동으로 1, 2, 3 순서 번호가 붙습니다.</p>
              </div>
              <div>
                <label for="offeringHymn" class="block text-xs text-gray-500 mb-1">찬송-2 / 봉헌찬송</label>
                <input id="offeringHymn" placeholder="예: 43장 1절만" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="hymnThree" class="block text-xs text-gray-500 mb-1">찬송-3</label>
                <input id="hymnThree" placeholder="예: 315장" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="hymnFour" class="block text-xs text-gray-500 mb-1">찬송-4</label>
                <input id="hymnFour" placeholder="예: 288장" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="specialSong" class="block text-xs text-gray-500 mb-1">특송</label>
                <select id="specialSong" class="w-full border rounded-lg px-3 py-2 text-sm">
                  <option value="remove">특송 슬라이드 제거</option>
                  <option value="keep">특송 있음</option>
                  <option value="none">확인 필요</option>
                </select>
              </div>
            </div>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">예배 순서</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div>
                <label for="responsiveReading" class="block text-xs text-gray-500 mb-1">교독문</label>
                <input id="responsiveReading" placeholder="예: 교독문 64. 시편 148편" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="prayer" class="block text-xs text-gray-500 mb-1">기도</label>
                <input id="prayer" placeholder="예: 김순규 장로" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div class="md:col-span-2 grid grid-cols-3 gap-3">
                <div>
                  <label for="rrFontSize" class="block text-xs text-gray-500 mb-1">교독문 글자크기</label>
                  <input id="rrFontSize" type="number" min="20" max="72" step="1" value="40" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label for="rrOddColor" class="block text-xs text-gray-500 mb-1">홀수절 색상</label>
                  <input id="rrOddColor" type="color" value="#000000" class="w-full h-[38px] border rounded-lg px-1 py-1" />
                </div>
                <div>
                  <label for="rrEvenColor" class="block text-xs text-gray-500 mb-1">짝수절 색상</label>
                  <input id="rrEvenColor" type="color" value="#ffd966" class="w-full h-[38px] border rounded-lg px-1 py-1" />
                </div>
              </div>
            </div>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">말씀과 설교</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div>
                <label for="scripture" class="block text-xs text-gray-500 mb-1">성경본문</label>
                <input id="scripture" placeholder="예: 고린도전서 8장 1절 ~ 13절" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="sermonTitle" class="block text-xs text-gray-500 mb-1">설교 제목</label>
                <input id="sermonTitle" placeholder="예: 자유와 사랑" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div class="md:col-span-2 grid grid-cols-3 gap-3">
                <div>
                  <label for="scriptureFontSize" class="block text-xs text-gray-500 mb-1">본문 글자크기</label>
                  <input id="scriptureFontSize" type="number" min="20" max="72" step="1" value="40" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label for="scriptureOddColor" class="block text-xs text-gray-500 mb-1">홀수절 색상</label>
                  <input id="scriptureOddColor" type="color" value="#000000" class="w-full h-[38px] border rounded-lg px-1 py-1" />
                </div>
                <div>
                  <label for="scriptureEvenColor" class="block text-xs text-gray-500 mb-1">짝수절 색상</label>
                  <input id="scriptureEvenColor" type="color" value="#ffd966" class="w-full h-[38px] border rounded-lg px-1 py-1" />
                </div>
              </div>
            </div>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">광고</h3>
            <div class="mt-3 grid gap-4">
              <div>
                <label for="announcements" class="block text-xs text-gray-500 mb-1">광고 (한 줄에 하나씩)</label>
                <textarea id="announcements" rows="3" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
              </div>
              <div>
                <label for="notes" class="block text-xs text-gray-500 mb-1">추가 요청</label>
                <textarea id="notes" rows="3" placeholder="PPT 수정 요청이나 방송실 전달사항" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
              </div>
            </div>
          </section>
        </form>
      </main>
    </div>
  </section>
</BaseLayout>

<script>
  const TOKEN_KEY = "dshouse_editor_token";

  const fields = [
    "serviceDate", "serviceType", "praiseMain", "offeringHymn", "hymnThree", "hymnFour",
    "specialSong", "responsiveReading", "prayer", "scripture", "sermonTitle",
    "announcements", "notes", "rrFontSize", "rrOddColor", "rrEvenColor",
    "scriptureFontSize", "scriptureOddColor", "scriptureEvenColor",
  ];

  const sample = {
    serviceDate: "2026-07-26",
    serviceType: "주일오전예배",
    praiseMain: "예배합니다.\n내가매일기쁘게\n주의친절한 팔에안기세\n주만바라볼지라",
    offeringHymn: "43장 1절만",
    hymnThree: "315장",
    hymnFour: "288장",
    specialSong: "remove",
    responsiveReading: "교독문 64. 시편 148편",
    prayer: "김순규 장로",
    scripture: "고린도전서 8장 1절 ~ 13절",
    sermonTitle: "자유와 사랑",
    announcements: "예배 후 여전도회 월례회가 본당에서 있습니다.\n7.21-24일 김삼열 목사 휴가",
    notes: "",
    rrFontSize: "40",
    rrOddColor: "#000000",
    rrEvenColor: "#ffd966",
    scriptureFontSize: "40",
    scriptureOddColor: "#000000",
    scriptureEvenColor: "#ffd966",
  };

  const gate = document.getElementById("token-gate");
  const appWrap = document.getElementById("app-wrap");
  const tokenInput = document.getElementById("token-input");
  const tokenSubmit = document.getElementById("token-submit");
  const tokenError = document.getElementById("token-error");
  const saveStatus = document.getElementById("saveStatus");
  const savedList = document.getElementById("savedList");

  let token = sessionStorage.getItem(TOKEN_KEY) || "";

  function el(id) {
    return document.getElementById(id);
  }

  function value(id) {
    const node = el(id);
    return node.type === "checkbox" ? node.checked : node.value.trim();
  }

  function formData() {
    return Object.fromEntries(
      fields.map((id) => {
        const node = el(id);
        return [id, node.type === "checkbox" ? node.checked : node.value];
      }),
    );
  }

  function applyData(data) {
    Object.entries(data).forEach(([id, dataValue]) => {
      const node = el(id);
      if (!node) return;
      if (node.type === "checkbox") {
        node.checked = Boolean(dataValue);
      } else {
        node.value = dataValue ?? "";
      }
    });
    render();
  }

  function dateStamp() {
    return value("serviceDate").replaceAll("-", "");
  }

  function lines(text) {
    return text.split("\n").map((line) => line.trim()).filter(Boolean);
  }

  function optionLine(fontId, oddColorId, evenColorId) {
    const options = [];
    if (value(fontId)) options.push(`글자크기 ${value(fontId)}`);
    if (value(oddColorId)) options.push(`홀수절 ${value(oddColorId)}`);
    if (value(evenColorId)) options.push(`짝수절 ${value(evenColorId)}`);
    return options.length ? options.join(", ") + "." : "";
  }

  function numberedBlock(text) {
    return lines(text).map((line, index) => `${index + 1}. ${line}`).join("\n");
  }

  function buildMaterial() {
    const chunks = [];
    chunks.push("### 찬양");
    chunks.push(numberedBlock(value("praiseMain")));
    chunks.push("\n### 찬송-2 (봉헌찬송)");
    chunks.push(value("offeringHymn"));
    chunks.push("\n### 교독문");
    chunks.push(value("responsiveReading"));
    chunks.push(optionLine("rrFontSize", "rrOddColor", "rrEvenColor"));
    chunks.push("\n### 찬송-3");
    chunks.push(value("hymnThree"));
    chunks.push("\n### 기도");
    chunks.push(value("prayer"));
    if (value("specialSong") === "remove") {
      chunks.push("\n### 특송 슬라이드 제거");
    } else if (value("specialSong") === "keep") {
      chunks.push("\n### 특송");
      chunks.push("특송 있음");
    } else {
      chunks.push("\n### 특송");
      chunks.push("확인 필요");
    }
    chunks.push("\n### 광고");
    chunks.push(lines(value("announcements")).join("\n"));
    chunks.push("\n### 성경본문");
    chunks.push(value("scripture"));
    chunks.push(optionLine("scriptureFontSize", "scriptureOddColor", "scriptureEvenColor"));
    chunks.push("\n### 설교");
    chunks.push(value("sermonTitle"));
    chunks.push("\n### 찬송-4");
    chunks.push(value("hymnFour"));
    const notes = value("notes");
    if (notes) {
      chunks.push("\n### 추가 요청");
      chunks.push(notes);
    }
    return chunks.join("\n").replace(/\n{3,}/g, "\n\n").trim() + "\n";
  }

  function validate() {
    const issues = [];
    const required = [
      ["찬양", value("praiseMain")],
      ["봉헌찬송", value("offeringHymn")],
      ["교독문", value("responsiveReading")],
      ["찬송-3", value("hymnThree")],
      ["기도", value("prayer")],
      ["성경본문", value("scripture")],
      ["설교", value("sermonTitle")],
      ["찬송-4", value("hymnFour")],
    ];
    required.forEach(([label, content]) => {
      if (!content) issues.push(["danger", `${label} 항목이 비어 있습니다.`]);
    });
    if (lines(value("praiseMain")).length < 2) {
      issues.push(["warn", "찬양 목록이 2곡 이하입니다. 예배 순서와 맞는지 확인하세요."]);
    }
    ["offeringHymn", "hymnThree", "hymnFour"].forEach((id) => {
      const text = value(id);
      if (text && !/\d+\s*장/.test(text)) {
        issues.push(["warn", `${el(id).previousElementSibling.textContent}에 찬송 장수가 보이지 않습니다.`]);
      }
    });
    const allText = buildMaterial();
    const previousDate = allText.match(/20\d{6}/g)?.find((stamp) => stamp !== dateStamp());
    if (previousDate) {
      issues.push(["danger", `선택한 예배 날짜와 다른 날짜(${previousDate})가 포함되어 있습니다.`]);
    }
    if (/contexts|수정해줘|확인해서|pptx/i.test(allText)) {
      issues.push(["warn", "작업 지시문처럼 보이는 문장이 포함되어 있습니다. 자료 본문인지 확인하세요."]);
    }
    if (!/(장|서)\s*\d+장\s*\d+절/.test(value("scripture"))) {
      issues.push(["warn", "성경본문 형식이 자동 조회에 애매할 수 있습니다. 예: 고린도전서 8장 1절 ~ 13절"]);
    }
    if (!issues.length) {
      issues.push(["ok", "필수 항목이 채워졌습니다. PPT 생성용 자료로 사용할 수 있습니다."]);
    }
    return issues;
  }

  function updateStatus() {
    const groups = [
      ["찬양팀", value("praiseMain") && value("offeringHymn") && value("hymnThree") && value("hymnFour")],
      ["예배순서", value("responsiveReading") && value("prayer")],
      ["말씀/설교", value("scripture") && value("sermonTitle")],
      ["광고", value("announcements")],
      ["검증", !validate().some(([type]) => type === "danger")],
    ];
    el("statusList").innerHTML = groups.map(([label, done]) => {
      const dotClass = done ? "bg-emerald-500" : "bg-amber-400";
      const state = done ? "완료" : "대기";
      return `<div class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full ${dotClass}"></span><span>${label} · ${state}</span></div>`;
    }).join("");
  }

  function render() {
    el("fileName").textContent = `자료 - ${dateStamp()}.txt`;
    el("issues").innerHTML = validate().map(([type, text]) => {
      const color = type === "danger" ? "text-red-500" : type === "warn" ? "text-amber-500" : "text-emerald-600";
      return `<li class="${color}">${text}</li>`;
    }).join("");
    updateStatus();
  }

  function sectionMap(text) {
    const sections = {};
    const matches = [...text.matchAll(/^###\s*(.+)$/gm)];
    matches.forEach((match, index) => {
      const title = match[1].trim();
      const start = match.index + match[0].length;
      const end = matches[index + 1]?.index ?? text.length;
      sections[title] = text.slice(start, end).trim();
    });
    return sections;
  }

  function stripNumbering(text) {
    return lines(text).map((line) => line.replace(/^\d+\.\s*/, "")).join("\n");
  }

  function splitContentAndOption(text) {
    const textLines = lines(text);
    const optionIndex = textLines.findIndex((line) => /글자크기|홀수절|짝수절/.test(line));
    if (optionIndex === -1) return { content: textLines.join("\n"), option: "" };
    return {
      content: textLines.slice(0, optionIndex).join("\n"),
      option: textLines.slice(optionIndex).join(" "),
    };
  }

  const OPTION_DEFAULTS = { fontSize: "40", oddColor: "#000000", evenColor: "#ffd966" };

  function parseOptionValues(option) {
    const font = option.match(/글자크기\s*(\d+)/);
    const odd = option.match(/홀수절\s*(#[0-9a-fA-F]{6})/);
    const even = option.match(/짝수절\s*(#[0-9a-fA-F]{6})/);
    return {
      fontSize: font ? font[1] : OPTION_DEFAULTS.fontSize,
      oddColor: odd ? odd[1] : OPTION_DEFAULTS.oddColor,
      evenColor: even ? even[1] : OPTION_DEFAULTS.evenColor,
    };
  }

  function parseMaterialText(text) {
    const sections = sectionMap(text);
    const nextData = formData();

    if (sections["찬양"] !== undefined) nextData.praiseMain = stripNumbering(sections["찬양"]);
    if (sections["찬송-2 (봉헌찬송)"] !== undefined) nextData.offeringHymn = sections["찬송-2 (봉헌찬송)"];
    if (sections["찬송-3"] !== undefined) nextData.hymnThree = sections["찬송-3"];
    if (sections["찬송-4"] !== undefined) nextData.hymnFour = sections["찬송-4"];
    if (sections["기도"] !== undefined) nextData.prayer = sections["기도"];
    if (sections["광고"] !== undefined) nextData.announcements = sections["광고"];
    if (sections["설교"] !== undefined) nextData.sermonTitle = sections["설교"];
    nextData.notes = sections["추가 요청"] ?? "";

    if (sections["특송 슬라이드 제거"] !== undefined) {
      nextData.specialSong = "remove";
    } else if (sections["특송"] !== undefined) {
      nextData.specialSong = /확인/.test(sections["특송"]) ? "none" : "keep";
    }

    if (sections["교독문"] !== undefined) {
      const parsed = splitContentAndOption(sections["교독문"]);
      nextData.responsiveReading = parsed.content;
      const opt = parseOptionValues(parsed.option);
      nextData.rrFontSize = opt.fontSize;
      nextData.rrOddColor = opt.oddColor;
      nextData.rrEvenColor = opt.evenColor;
    }

    if (sections["성경본문"] !== undefined) {
      const parsed = splitContentAndOption(sections["성경본문"]);
      nextData.scripture = parsed.content;
      const opt = parseOptionValues(parsed.option);
      nextData.scriptureFontSize = opt.fontSize;
      nextData.scriptureOddColor = opt.oddColor;
      nextData.scriptureEvenColor = opt.evenColor;
    }

    return nextData;
  }

  function loadSample() {
    Object.entries(sample).forEach(([id, data]) => {
      const node = el(id);
      if (node.type === "checkbox") node.checked = data;
      else node.value = data;
    });
    render();
  }

  // --- 버킷 연동 ---
  function showGate(message) {
    sessionStorage.removeItem(TOKEN_KEY);
    token = "";
    appWrap.classList.add("hidden");
    gate.classList.remove("hidden");
    if (message) {
      tokenError.textContent = message;
      tokenError.classList.remove("hidden");
    }
  }

  async function authedFetch(input, init = {}) {
    const res = await fetch(input, {
      ...init,
      headers: { ...(init.headers || {}), "x-editor-token": token },
    });
    if (res.status === 401) {
      showGate("토큰이 올바르지 않습니다.");
      throw new Error("unauthorized");
    }
    return res;
  }

  async function loadBucketList() {
    savedList.innerHTML = '<li class="text-gray-500">불러오는 중…</li>';
    const res = await authedFetch("/api/bucket-list");
    const items = await res.json();
    if (!items.length) {
      savedList.innerHTML = '<li class="text-gray-500">저장된 자료가 없습니다.</li>';
      return items;
    }
    savedList.innerHTML = "";
    for (const item of items) {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "w-full text-left rounded-lg border px-3 py-2 text-xs hover:bg-black/5 dark:hover:bg-white/10 dark:border-white/20";
      const savedAt = item.savedAt ? new Date(item.savedAt).toLocaleString("ko-KR") : "";
      btn.innerHTML = `<div class="font-medium">${item.name}</div><div class="text-gray-500">${savedAt}</div>`;
      btn.addEventListener("click", () => loadFromBucket(item.name));
      li.appendChild(btn);
      savedList.appendChild(li);
    }
    return items;
  }

  async function loadInitial() {
    const items = await loadBucketList();
    if (items.length) {
      await loadFromBucket(items[0].name);
    } else {
      loadSample();
    }
  }

  async function loadFromBucket(name) {
    saveStatus.textContent = "불러오는 중…";
    const res = await authedFetch(`/api/bucket-file?name=${encodeURIComponent(name)}`);
    if (!res.ok) {
      saveStatus.textContent = "불러오기 실패";
      return;
    }
    const text = await res.text();
    const parsed = parseMaterialText(text);
    const date = name.match(/20\d{6}/)?.[0];
    if (date) {
      parsed.serviceDate = `${date.slice(0, 4)}-${date.slice(4, 6)}-${date.slice(6, 8)}`;
    }
    applyData(parsed);
    saveStatus.textContent = `"${name}" 불러옴`;
  }

  async function saveToBucket() {
    const name = `자료 - ${dateStamp()}.txt`;
    saveStatus.textContent = "저장 중…";
    const res = await authedFetch("/api/bucket-file", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, content: buildMaterial() }),
    });
    if (!res.ok) {
      saveStatus.textContent = "저장 실패";
      return;
    }
    saveStatus.textContent = `"${name}" 저장됨`;
    loadBucketList();
  }

  // --- 이벤트 바인딩 ---
  fields.forEach((id) => {
    const node = el(id);
    node.addEventListener("input", render);
    node.addEventListener("change", render);
  });

  el("saveBtn").addEventListener("click", saveToBucket);
  el("refreshBtn").addEventListener("click", loadBucketList);

  el("serviceDate").addEventListener("click", (e) => {
    if (typeof e.target.showPicker === "function") {
      e.target.showPicker();
    }
  });

  tokenSubmit.addEventListener("click", async () => {
    token = tokenInput.value.trim();
    if (!token) return;
    sessionStorage.setItem(TOKEN_KEY, token);
    tokenError.classList.add("hidden");
    gate.classList.add("hidden");
    appWrap.classList.remove("hidden");
    await loadInitial();
  });

  tokenInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") tokenSubmit.dispatchEvent(new Event("click"));
  });

  if (token) {
    gate.classList.add("hidden");
    appWrap.classList.remove("hidden");
    loadInitial();
  } else {
    loadSample();
  }
</script>
