---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/company";
export const prerender = true;
---
<BaseLayout title="Contact | 이동수하우스" description="프로젝트 문의와 상담 요청을 받습니다. 필요한 범위만 빠르게 진행합니다.">
  <!-- HERO — 다른 페이지와 동일한 히어로 체계 -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true"
         class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>
    <h1 class="rise text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">문의하기</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      어떤 문제를 풀고 싶은지 편하게 적어주세요. 파일럿부터 운영까지, 필요한 범위만 진행합니다.
    </p>
  </section>

  <form id="contact-form"
        action="https://formspree.io/f/xqalvjwd"
        method="POST"
        accept-charset="UTF-8"
        data-reveal
        class="card rounded-2xl mt-10 max-w-xl space-y-4">

    <!-- 이름 -->
    <label class="block text-sm font-medium" for="name">이름</label>
    <input id="name" name="name" required
           autocomplete="name"
           class="w-full border rounded-lg px-4 py-3" />

    <!-- 이메일 -->
    <label class="block text-sm font-medium" for="email">이메일</label>
    <input id="email" name="email" type="email" required
           autocomplete="email"
           inputmode="email"
           class="w-full border rounded-lg px-4 py-3" />

    <!-- 메시지 -->
    <label class="block text-sm font-medium" for="message">문의 내용</label>
    <textarea id="message" name="message" rows="6" required
              class="w-full border rounded-lg px-4 py-3"></textarea>

    <!-- (선택) 전화번호: 원하시면 사용 -->
    <!--
    <label class="block text-sm font-medium" for="phone">연락처(선택)</label>
    <input id="phone" name="phone" type="tel"
           autocomplete="tel"
           class="w-full border rounded-lg px-4 py-3" />
    -->

    <!-- 허니팟(봇 차단용) -->
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty
        <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <!-- (선택) 제목 설정 -->
    <input type="hidden" name="subject" value="이동수하우스 문의" />

    <!-- 개인정보 수집·이용 및 국외 이전 동의 (필수) -->
    <div class="rounded-xl border border-black/10 dark:border-white/15 p-4 bg-black/[0.02] dark:bg-white/[0.03]">
      <label for="privacy-consent" class="flex items-start gap-3 cursor-pointer">
        <input
          id="privacy-consent"
          name="privacy_consent"
          type="checkbox"
          required
          class="mt-1 h-5 w-5 shrink-0 rounded border-gray-400 accent-[--color-accent]"
        />
        <span class="text-sm leading-relaxed">
          <span class="font-medium">[필수] 개인정보 수집·이용 및 국외 이전에 동의합니다.</span>
          <span class="mt-1 block text-gray-600 dark:text-gray-400">
            수집 항목: 이름, 이메일, 문의 내용 · 목적: 문의 답변 · 보유 기간: 처리 완료 후 3년.
            문의 접수는 미국 서비스인 Formspree를 통해 처리되어 해당 정보가 국외로 이전됩니다.
            동의를 거부하실 수 있으며, 이 경우 아래 이메일이나 전화로 직접 문의해 주세요.
          </span>
          <a href="/privacy" class="mt-1 inline-block underline underline-offset-2">
            개인정보처리방침 전문 보기
          </a>
        </span>
      </label>
    </div>

    <button id="submit-btn" type="submit" class="btn btn-primary">
      보내기
    </button>

    <!-- 상태 메시지 -->
    <p id="form-status" class="text-sm text-gray-600 dark:text-gray-300 mt-2" aria-live="polite"></p>
  </form>

  <div data-reveal class="mt-10 card rounded-2xl max-w-xl">
    <h2 class="font-semibold">폼 대신 직접 연락하기</h2>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      국외 이전에 동의하지 않으셔도 아래로 연락 주시면 동일하게 상담해 드립니다.
    </p>
    <p class="mt-3 text-sm">
      이메일: <a href={`mailto:${company.email}`} class="underline underline-offset-2">{company.email}</a>
      <span class="mx-2 text-gray-400">·</span>
      전화: <span>010-6645-</span><span>0137</span>
    </p>
  </div>

  <script>
    const form = document.getElementById('contact-form');
    const statusEl = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn');

    const consent = document.getElementById('privacy-consent');

    form.addEventListener('submit', async (e) => {
      // 개인정보 수집·이용 동의는 전송의 전제 조건입니다.
      // required 속성으로 브라우저가 먼저 막지만, 스크립트에서도 한 번 더 확인합니다.
      if (!consent.checked) {
        e.preventDefault();
        statusEl.textContent = '개인정보 수집·이용에 동의해 주세요.';
        consent.focus();
        return;
      }

      // 간단 이메일 검증
      const email = form.email?.value || '';
      if (!email.includes('@')) {
        e.preventDefault();
        statusEl.textContent = '이메일 형식이 올바르지 않습니다.';
        return;
      }

      e.preventDefault();
      btn.disabled = true;
      statusEl.textContent = '전송 중입니다...';

      try {
        const data = new FormData(form);
        // 허니팟이 채워져 있으면 전송 중단
        if (data.get('_hp')) {
          statusEl.textContent = '전송이 차단되었습니다.';
          btn.disabled = false;
          return;
        }

        const res = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (res.ok) {
          form.reset();
          statusEl.textContent = '전송되었습니다. 확인 후 연락드리겠습니다.';
        } else {
          statusEl.textContent = '전송에 실패했습니다. 잠시 후 다시 시도해 주세요.';
        }
      } catch (err) {
        statusEl.textContent = '네트워크 오류가 발생했습니다.';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
