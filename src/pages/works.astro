---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const entries = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);

// detail: true 인 항목만 상세 페이지를 가집니다.
const projects = entries.map((entry) => ({
  entry,
  hasDetail: entry.data.detail,
}));

// 실제로 쓰인 카테고리만 필터로 노출
const categories = [...new Set(entries.map((e) => e.data.category))];

const statusStyle: Record<string, string> = {
  운영: "border-emerald-500/40 text-emerald-600 dark:text-emerald-400",
  파일럿: "border-amber-500/40 text-amber-600 dark:text-amber-400",
  시제품: "border-sky-500/40 text-sky-600 dark:text-sky-400",
  샘플: "border-gray-400/40 text-gray-500 dark:text-gray-400",
};
---

<BaseLayout
  title="Works | 이동수하우스"
  description="자동화·공공데이터·하이브리드 프로젝트 사례입니다. 공개 가능한 범위에서 요약했습니다."
>
  <!-- HERO -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true" class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>
    <div aria-hidden="true" class="absolute -bottom-28 -right-10 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(110,231,255,0.25),_transparent_60%)]"></div>

    <h1 class="rise text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">Works</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      작은 실험에서 시작해 운영으로 이어진 사례들입니다. 공개 가능한 범위에서 요약했습니다.
    </p>
  </section>

  <!-- 필터 -->
  <section data-reveal class="mt-10">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="분야로 거르기">
      <button
        type="button"
        class="filter-chip is-active rounded-full border px-4 py-2 text-sm"
        data-filter="all"
        aria-pressed="true"
      >
        전체 <span class="ml-1 text-xs opacity-60">{entries.length}</span>
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            class="filter-chip rounded-full border px-4 py-2 text-sm"
            data-filter={category}
            aria-pressed="false"
          >
            {category}
            <span class="ml-1 text-xs opacity-60">
              {entries.filter((e) => e.data.category === category).length}
            </span>
          </button>
        ))
      }
    </div>

    <!-- 카드 목록 -->
    <div id="project-grid" class="mt-8 grid gap-6 md:grid-cols-2">
      {
        projects.map(({ entry, hasDetail }, index) => {
          const data = entry.data;
          const href = `/works/${entry.slug}`;
          return (
            <article
              class="project-card p-[1px] rounded-2xl bg-gradient-to-br from-[rgba(71,163,255,0.6)] to-[rgba(110,231,255,0.4)]"
              data-category={data.category}
              data-reveal
              data-reveal-delay={String((index % 4) + 1)}
            >
              <div
                class:list={[
                  "card rounded-2xl bg-white/80 dark:bg-white/5 h-full flex flex-col",
                  hasDetail && "card-linked",
                ]}
              >
                <header class="flex items-start justify-between gap-3">
                  <h2 class="text-lg font-semibold">
                    {hasDetail ? (
                      <a href={href} class="hover:underline">
                        {data.title}
                      </a>
                    ) : (
                      data.title
                    )}
                  </h2>
                  <span class={`shrink-0 rounded-full border px-2 py-1 text-xs ${statusStyle[data.status]}`}>
                    {data.status}
                  </span>
                </header>

                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                  {data.category}
                  {data.org && <span> · {data.org}</span>}
                </p>

                <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">{data.summary}</p>

                {(data.before || data.after) && (
                  <div class="mt-4 flex items-center gap-3 text-sm">
                    <span class="text-gray-500 line-through decoration-gray-400">{data.before}</span>
                    <span aria-hidden="true" class="text-gray-400">→</span>
                    <span class="font-semibold gradient-text">{data.after}</span>
                  </div>
                )}

                {data.highlights.length > 0 && (
                  <ul class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                    {data.highlights.map((item) => (
                      <li>· {item}</li>
                    ))}
                  </ul>
                )}

                {data.stack.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2 text-xs text-gray-500 dark:text-gray-400">
                    {data.stack.map((item) => (
                      <li class="rounded-md border border-black/5 dark:border-white/10 px-2 py-1">{item}</li>
                    ))}
                  </ul>
                )}

                {(hasDetail || data.tool) && (
                  <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/10 flex flex-wrap items-center gap-4 text-sm">
                    {hasDetail && (
                      <a href={href} class="font-medium hover:underline">
                        자세히 보기 →
                      </a>
                    )}
                    {data.tool && (
                      <a
                        href={data.tool.href}
                        target={data.tool.external ? "_blank" : undefined}
                        rel={data.tool.external ? "noopener noreferrer" : undefined}
                        class="text-gray-500 dark:text-gray-400 hover:underline"
                      >
                        {data.tool.label}
                        {data.tool.gated && <span class="ml-1 text-xs">🔒</span>}
                      </a>
                    )}
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <p id="empty-state" class="mt-8 hidden text-sm text-gray-500 dark:text-gray-400">
      해당 분야의 사례가 아직 없습니다.
    </p>
  </section>

  <!-- CTA -->
  <section data-reveal class="mt-16 text-center rounded-2xl p-10 border border-black/5 dark:border-white/10
                   bg-[linear-gradient(135deg,rgba(71,163,255,0.12),rgba(110,231,255,0.12))]">
    <h2 class="text-2xl font-bold">비슷한 프로젝트를 시작해볼까요?</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">파일럿부터 운영까지, 필요한 범위만 빠르게 진행합니다.</p>
    <a href="/contact" class="mt-6 inline-block btn btn-primary">상담 요청</a>
  </section>
</BaseLayout>

<script is:inline>
  // 카테고리 필터 — JS가 없으면 전체가 그대로 보입니다.
  const chips = document.querySelectorAll(".filter-chip");
  const cards = document.querySelectorAll(".project-card");
  const emptyState = document.getElementById("empty-state");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;

      chips.forEach((other) => {
        const active = other === chip;
        other.classList.toggle("is-active", active);
        other.setAttribute("aria-pressed", String(active));
      });

      let visible = 0;
      cards.forEach((card) => {
        const match = filter === "all" || card.dataset.category === filter;
        card.hidden = !match;
        if (match) visible += 1;
      });

      emptyState.classList.toggle("hidden", visible > 0);
    });
  });
</script>
