---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
---
<BaseLayout
  title="페이지를 찾을 수 없습니다 | 이동수하우스"
  description="요청하신 페이지가 없거나 이동되었습니다."
>
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10 text-center">
    <div aria-hidden="true"
         class="absolute -top-24 left-1/2 -translate-x-1/2 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>

    <p class="rise text-6xl md:text-7xl font-extrabold leading-none">
      <span class="gradient-text">404</span>
    </p>
    <h1 class="rise mt-6 text-2xl md:text-3xl font-bold" style="--rise-delay:110ms">
      페이지를 찾을 수 없습니다
    </h1>
    <p class="rise mt-3 text-gray-600 dark:text-gray-300" style="--rise-delay:180ms">
      요청하신 주소가 없거나 다른 곳으로 이동했습니다.
    </p>
    <div class="rise mt-8 flex flex-wrap items-center justify-center gap-3" style="--rise-delay:250ms">
      <a href="/" class="btn btn-primary">홈으로</a>
      <a href="/contact" class="btn btn-ghost">문의하기</a>
    </div>
  </section>

  <section data-reveal class="mt-10">
    <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400">이런 페이지를 찾으셨나요?</h2>
    <ul class="mt-4 grid gap-3 md:grid-cols-3">
      <li>
        <a href="/services" class="card card-linked rounded-2xl block">
          <span class="font-semibold">Services</span>
          <span class="mt-1 block text-sm text-gray-600 dark:text-gray-300">구축 패키지와 진행 방식</span>
        </a>
      </li>
      <li>
        <a href="/automation" class="card card-linked rounded-2xl block">
          <span class="font-semibold">자동화 프로젝트</span>
          <span class="mt-1 block text-sm text-gray-600 dark:text-gray-300">반복 업무 자동화 기록</span>
        </a>
      </li>
      <li>
        <a href="/ai-service" class="card card-linked rounded-2xl block">
          <span class="font-semibold">AI 서비스</span>
          <span class="mt-1 block text-sm text-gray-600 dark:text-gray-300">AI 동네 리포트</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
