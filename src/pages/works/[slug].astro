---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection("works");
  // detail: true 인 사례만 상세 페이지를 만듭니다. 나머지는 목록 카드로만 노출됩니다.
  return entries
    .filter((entry) => entry.data.detail)
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<"works"> };
const { entry } = Astro.props as Props;
const { Content } = await entry.render();
const data = entry.data;

// 손이 가는 단계와 알아서 되는 단계를 색으로 구분합니다.
const actorStyle: Record<string, string> = {
  담당자: "border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-300",
  자동: "border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300",
};

const autoCount = (steps: { actor: string }[]) =>
  steps.filter((s) => s.actor === "자동").length;
---

<BaseLayout title={`${data.title} | 이동수하우스`} description={data.summary}>
  <!-- HERO -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true" class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>

    <nav class="text-sm text-gray-500 dark:text-gray-400">
      <a href="/works" class="hover:underline">Works</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span>{data.category}</span>
    </nav>

    <h1 class="rise mt-4 text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">{data.title}</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      {data.summary}
    </p>

    <div class="rise mt-6 flex flex-wrap items-center gap-3 text-sm" style="--rise-delay:220ms">
      <span class="rounded-full border px-3 py-1">{data.status}</span>
      {data.org && <span class="rounded-full border px-3 py-1">{data.org}</span>}
      {
        (data.before || data.after) && (
          <span class="rounded-full border px-3 py-1">
            <span class="text-gray-500 line-through">{data.before}</span>
            <span aria-hidden="true" class="mx-2 text-gray-400">→</span>
            <span class="font-semibold">{data.after}</span>
          </span>
        )
      }
      {
        data.tool && (
          <a
            href={data.tool.href}
            target={data.tool.external ? "_blank" : undefined}
            rel={data.tool.external ? "noopener noreferrer" : undefined}
            class="btn btn-primary btn-sm"
          >
            {data.tool.label}
            {data.tool.gated && <span class="ml-1">🔒</span>}
          </a>
        )
      }
    </div>
  </section>

  {
    data.gallery.length > 0 && (
      <section data-reveal class="mt-12">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-bold">실제 결과물</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {data.gallery.length}장 · 실제 생성된 슬라이드입니다
          </p>
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {data.gallery.map((shot, index) => (
            <figure data-reveal data-reveal-delay={String((index % 3) + 1)}>
              <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/15 bg-white">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                  class="block w-full h-auto"
                />
              </div>
              {shot.caption && (
                <figcaption class="mt-2 text-xs leading-relaxed text-gray-600 dark:text-gray-400">
                  {shot.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>

        <p class="mt-6 text-xs text-gray-500 dark:text-gray-400">
          개인정보 보호를 위해 담당자 이름은 ○○○로 가렸고, 저작권이 있는 찬송 악보 슬라이드는 제외했습니다.
        </p>
      </section>
    )
  }

  <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
    <!-- 본문 -->
    <article class="prose-ds" data-reveal>
      <Content />
    </article>

    <!-- 사이드: 파이프라인 + 스택 -->
    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      {
        data.pipeline.length > 0 && (
          <div class="card rounded-2xl" data-reveal data-reveal-delay="1">
            <h2 class="text-sm font-semibold">진행 순서</h2>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
              {data.pipeline.length}단계 중 {autoCount(data.pipeline)}단계가 자동입니다
            </p>
            <ol class="mt-4 space-y-1">
              {data.pipeline.map((step, index) => (
                <li>
                  <div class="flex items-start gap-3">
                    <span class="mt-0.5 shrink-0 w-6 h-6 rounded-full border border-black/10 dark:border-white/15 grid place-items-center text-xs font-semibold">
                      {index + 1}
                    </span>
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm font-medium">{step.label}</span>
                        <span class={`rounded-md border px-1.5 py-0.5 text-[10px] ${actorStyle[step.actor]}`}>
                          {step.actor}
                        </span>
                      </div>
                      {step.detail && (
                        <p class="mt-1 text-xs leading-relaxed text-gray-600 dark:text-gray-300">
                          {step.detail}
                        </p>
                      )}
                      {step.items.length > 0 && (
                        <ul class="mt-2 flex flex-wrap gap-1.5">
                          {step.items.map((item) => (
                            <li class="rounded-md border border-amber-500/40 bg-amber-500/10 px-2 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-300">
                              {item}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                  {index < data.pipeline.length - 1 && (
                    <div aria-hidden="true" class="ml-3 h-4 w-px bg-black/10 dark:bg-white/15" />
                  )}
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        data.stack.length > 0 && (
          <div class="card rounded-2xl" data-reveal data-reveal-delay="2">
            <h2 class="text-sm font-semibold">사용 기술</h2>
            <ul class="mt-3 flex flex-wrap gap-2 text-xs text-gray-600 dark:text-gray-300">
              {data.stack.map((item) => (
                <li class="rounded-md border border-black/5 dark:border-white/10 px-2 py-1">{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="card rounded-2xl" data-reveal data-reveal-delay="3">
        <h2 class="text-sm font-semibold">비슷한 작업이 필요하신가요?</h2>
        <p class="mt-2 text-xs text-gray-600 dark:text-gray-300">
          어디까지 줄일 수 있는지 함께 살펴봅니다.
        </p>
        <a href="/contact" class="mt-4 inline-block btn btn-primary btn-sm">문의하기</a>
      </div>
    </aside>
  </div>

  <div class="mt-16">
    <a href="/works" class="text-sm hover:underline">← Works 목록</a>
  </div>
</BaseLayout>
