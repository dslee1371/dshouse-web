---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const APP_URL = "https://worshipppt.dsdshouse.com";

// 앱이 실제로 만들어 주는 슬라이드 종류
const slideKinds = [
  {
    title: "예배 순서",
    detail: "찬양·기도·봉헌·축도까지 순서를 슬라이드로 정리합니다.",
  },
  {
    title: "찬양 가사",
    detail: "가사를 화면에 맞게 나눠 배치합니다. 악보 파일이 없어도 됩니다.",
  },
  {
    title: "성경 본문",
    detail: "본문을 절 단위로 나눠 읽기 좋은 크기로 배치합니다.",
  },
  {
    title: "설교",
    detail: "제목과 본문 구절을 담은 설교 슬라이드를 만듭니다.",
  },
];
---

<BaseLayout
  title="예배 PPT 생성기 | 이동수하우스"
  description="예배 순서·찬양 가사·성경 본문·설교 슬라이드를 만들고 Google Slides나 PPTX로 내보내는 도구입니다."
>
  <!-- HERO -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true"
         class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>
    <div aria-hidden="true"
         class="absolute -bottom-28 -right-10 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(110,231,255,0.25),_transparent_60%)]"></div>

    <span class="inline-block rounded-full border px-3 py-1 text-xs">운영 중 · 무료 사용</span>

    <h1 class="rise mt-4 text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">예배 PPT 생성기</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      예배 순서, 찬양 가사, 성경 본문, 설교 슬라이드를 만들고
      Google Slides나 PPTX 파일로 내보냅니다. 매주 같은 작업을 반복하는 방송실을 위한 도구입니다.
    </p>

    <div class="rise mt-8 flex flex-wrap items-center gap-3" style="--rise-delay:220ms">
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        생성기 열기
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="ml-2" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <path d="M15 3h6v6M10 14L21 3" />
        </svg>
        <span class="sr-only">(새 창에서 열림)</span>
      </a>
      <a href="/contact" class="btn btn-ghost">우리 교회에 맞게 문의</a>
    </div>
  </section>

  <!-- 무엇을 만들어 주나 -->
  <section data-reveal class="mt-14">
    <h2 class="text-2xl font-bold">무엇을 만들어 주나</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      주보에 들어가는 내용을 그대로 슬라이드로 옮깁니다.
    </p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        slideKinds.map((kind, index) => (
          <div class="card rounded-2xl" data-reveal data-reveal-delay={String(index + 1)}>
            <h3 class="font-semibold">{kind.title}</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{kind.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 내보내기 -->
  <section data-reveal class="mt-14">
    <h2 class="text-2xl font-bold">만든 다음에는</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="card rounded-2xl">
        <h3 class="font-semibold">Google Slides로 보내기</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          브라우저에서 바로 이어서 편집하고, 링크로 팀과 나눌 수 있습니다.
          방송실 컴퓨터에 파일을 옮기지 않아도 됩니다.
        </p>
      </div>
      <div class="card rounded-2xl">
        <h3 class="font-semibold">PPTX 파일로 내려받기</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          쓰던 파워포인트에서 열어 다듬을 수 있습니다.
          기존 예배 템플릿에 맞춰 손보기 좋습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 어디서 시작됐나 -->
  <section data-reveal class="mt-14">
    <div class="card rounded-2xl bg-[linear-gradient(135deg,rgba(71,163,255,0.08),rgba(110,231,255,0.08))]">
      <h2 class="text-xl font-bold">어디서 시작됐나</h2>
      <p class="mt-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
        예원교회의 예배자료를 자동화하면서 시작됐습니다. 담당자 입력을 모아 주보를 만드는 것까지는
        풀었지만, 슬라이드 디자인은 매주 손이 갔습니다. 이 도구는 그 부분을 떼어내
        어느 교회에서나 쓸 수 있게 만든 것입니다.
      </p>
      <a href="/automation/church-bulletin" class="mt-4 inline-block text-sm font-medium hover:underline">
        예원교회 주보 자동화 사례 보기 →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section data-reveal class="mt-16 text-center rounded-2xl p-10 border border-black/5 dark:border-white/10
                  bg-[linear-gradient(135deg,rgba(71,163,255,0.12),rgba(110,231,255,0.12))]">
    <h2 class="text-2xl font-bold">먼저 써보세요</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      가입 없이 바로 만들어 볼 수 있습니다. 교회 사정에 맞춘 조정이 필요하면 알려주세요.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        생성기 열기
      </a>
      <a href="/contact" class="btn btn-ghost">상담 요청</a>
    </div>
  </section>
</BaseLayout>
