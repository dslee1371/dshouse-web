---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const APP_URL = "https://worshipppt.dsdshouse.com";

// Design에서 만들 수 있는 슬라이드 종류
const slideKinds = [
  {
    title: "예배 순서",
    detail: "찬양·기도·봉헌·축도까지 순서를 슬라이드로 정리합니다.",
  },
  {
    title: "찬양 가사",
    detail: "가사를 화면에 맞게 나눠 배치합니다. 악보 파일이 없어도 됩니다.",
  },
  {
    title: "성경 본문",
    detail: "본문을 절 단위로 나눠 읽기 좋은 크기로 배치합니다.",
  },
  {
    title: "설교",
    detail: "제목과 본문 구절을 담은 설교 슬라이드를 만듭니다.",
  },
];
---

<BaseLayout
  title="예배 PPT | 이동수하우스"
  description="예배 슬라이드를 만드는 두 가지 방법 — 직접 디자인하는 Design과 자료에서 통째로 만들어내는 자동 생성 툴."
>
  <!-- HERO -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true"
         class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>
    <div aria-hidden="true"
         class="absolute -bottom-28 -right-10 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(110,231,255,0.25),_transparent_60%)]"></div>

    <h1 class="rise text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">예배 PPT</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      매주 반복되는 예배 슬라이드 작업을 줄이는 두 가지 방법입니다.
      직접 만들어 보는 Design과, 예배자료에서 통째로 만들어내는 자동 생성 툴입니다.
    </p>
  </section>

  <!-- 두 갈래 -->
  <section data-reveal class="mt-12">
    <h2 class="text-2xl font-bold">두 가지 방법</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      하나는 지금 바로 써보는 공개 도구, 하나는 교회에 맞춰 만들어 드리는 구축입니다.
    </p>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {/* 1) Design — 직접 만들어 보는 쪽 */}
      <article
        class="p-[1px] rounded-2xl bg-gradient-to-br from-[rgba(71,163,255,0.6)] to-[rgba(110,231,255,0.4)]"
        data-reveal
        data-reveal-delay="1"
      >
        <div class="card rounded-2xl bg-white/80 dark:bg-white/5 h-full flex flex-col">
          <header class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-semibold">예배 PPT Design</h3>
            <span class="shrink-0 rounded-full border border-emerald-500/40 px-2 py-1 text-xs text-emerald-600 dark:text-emerald-400">
              바로 사용
            </span>
          </header>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
            가사와 본문을 넣으면 정돈된 디자인의 슬라이드가 나옵니다.
            악보 파일이 없어도 되고, 어느 교회에서나 쓸 수 있습니다.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <li>· 예배 순서 · 찬양 가사 · 성경 본문 · 설교 슬라이드</li>
            <li>· 디자인 템플릿에 맞춰 자동 배치</li>
            <li>· Google Slides 또는 PPTX로 내보내기</li>
          </ul>
          <div class="mt-auto pt-6">
            <a
              href={APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm btn-block"
            >
              Design 열어보기
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   class="ml-2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <path d="M15 3h6v6M10 14L21 3" />
              </svg>
              <span class="sr-only">(새 창에서 열림)</span>
            </a>
          </div>
        </div>
      </article>

      {/* 2) 자동 생성 툴 — 자료에서 통째로 만들어내는 쪽 */}
      <article
        class="p-[1px] rounded-2xl bg-gradient-to-br from-[rgba(71,163,255,0.6)] to-[rgba(110,231,255,0.4)]"
        data-reveal
        data-reveal-delay="2"
      >
        <div class="card rounded-2xl bg-white/80 dark:bg-white/5 h-full flex flex-col">
          <header class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-semibold">예배 PPT 자동 생성 툴</h3>
            <span class="shrink-0 rounded-full border px-2 py-1 text-xs">교회별 구축</span>
          </header>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
            예배자료를 한 번 입력하면 주보와 예배 PPT가 통째로 나옵니다.
            이미 가진 악보 자산과 예배 형식을 그대로 씁니다.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <li>· 담당자 입력 폼 + 실시간 검증</li>
            <li>· 주보 PDF 자동 조판</li>
            <li>· 보유한 악보로 슬라이드 조립</li>
          </ul>

          {/* 기대-실제 간극 방지: 바로 쓰는 공개 도구가 아님을 미리 알립니다 */}
          <p class="mt-4 rounded-lg border border-black/10 dark:border-white/15 bg-black/[0.03] dark:bg-white/[0.04] px-3 py-2 text-xs leading-relaxed text-gray-600 dark:text-gray-400">
            교회마다 예배 형식과 자료가 달라 <strong class="font-medium">개별 구축</strong>으로 진행합니다.
            바로 가입해서 쓰는 공개 도구는 아닙니다.
          </p>

          <div class="mt-auto pt-6">
            <a href="/works/church-bulletin" class="btn btn-ghost btn-sm btn-block">
              예원교회 사례 보기
            </a>
          </div>
        </div>
      </article>
    </div>

    <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
      먼저 Design으로 만들어 보고, 매주 반복되는 부분이 보이면 그때 자동 생성으로 넘어가는 순서를 권합니다.
    </p>
  </section>

  {/* Design 상세 */}
  <section data-reveal class="mt-16">
    <h2 class="text-2xl font-bold">Design에서 만들 수 있는 슬라이드</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        slideKinds.map((kind, index) => (
          <div class="card rounded-2xl" data-reveal data-reveal-delay={String((index % 4) + 1)}>
            <h3 class="font-semibold">{kind.title}</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{kind.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 내보내기 -->
  <section data-reveal class="mt-14">
    <h2 class="text-2xl font-bold">만든 다음에는</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="card rounded-2xl">
        <h3 class="font-semibold">Google Slides로 보내기</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          브라우저에서 바로 이어서 편집하고, 링크로 팀과 나눌 수 있습니다.
          방송실 컴퓨터에 파일을 옮기지 않아도 됩니다.
        </p>
      </div>
      <div class="card rounded-2xl">
        <h3 class="font-semibold">PPTX 파일로 내려받기</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          쓰던 파워포인트에서 열어 다듬을 수 있습니다.
          기존 예배 템플릿에 맞춰 손보기 좋습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section data-reveal class="mt-16 text-center rounded-2xl p-10 border border-black/5 dark:border-white/10
                  bg-[linear-gradient(135deg,rgba(71,163,255,0.12),rgba(110,231,255,0.12))]">
    <h2 class="text-2xl font-bold">먼저 써보세요</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      써본 뒤에 교회 사정에 맞춘 조정이 필요하면 알려주세요.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Design 열어보기
      </a>
      <a href="/contact" class="btn btn-ghost">구축 상담</a>
    </div>
  </section>
</BaseLayout>
