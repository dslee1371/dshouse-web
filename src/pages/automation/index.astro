---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const projects = (await getCollection("automation")).sort(
  (a, b) => a.data.order - b.data.order,
);

const statusStyle: Record<string, string> = {
  운영: "border-emerald-500/40 text-emerald-600 dark:text-emerald-400",
  파일럿: "border-amber-500/40 text-amber-600 dark:text-amber-400",
  아이디어: "border-gray-400/40 text-gray-500 dark:text-gray-400",
};
---

<BaseLayout
  title="자동화 프로젝트 | 이동수하우스"
  description="매주 반복되는 문서·운영 업무를 자동화한 프로젝트 기록입니다."
>
  <!-- HERO -->
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <div aria-hidden="true" class="absolute -top-24 -left-24 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(71,163,255,0.25),_transparent_60%)]"></div>
    <div aria-hidden="true" class="absolute -bottom-28 -right-10 w-[520px] h-[520px] rounded-full blur-3xl opacity-60 pointer-events-none
                bg-[radial-gradient(circle_at_center,_rgba(110,231,255,0.25),_transparent_60%)]"></div>

    <h1 class="rise text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">자동화 프로젝트</span>
    </h1>
    <p class="rise mt-4 max-w-2xl text-gray-600 dark:text-gray-300" style="--rise-delay:110ms">
      매주·매월 반복되는 문서 작업과 현장 운영을 자동화한 기록입니다.
      실제로 돌아가고 있는 것만 올립니다.
    </p>
  </section>

  <!-- 프로젝트 목록 -->
  <section class="mt-12 grid gap-6 md:grid-cols-2">
    {
      projects.map((project, index) => (
        <article
          class="p-[1px] rounded-2xl bg-gradient-to-br from-[rgba(71,163,255,0.6)] to-[rgba(110,231,255,0.4)]"
          data-reveal
          data-reveal-delay={String((index % 4) + 1)}
        >
          <div class="card card-linked rounded-2xl bg-white/80 dark:bg-white/5 h-full flex flex-col">
            <header class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-semibold">
                <a href={`/automation/${project.slug}`} class="hover:underline">
                  {project.data.title}
                </a>
              </h2>
              <span
                class={`shrink-0 rounded-full border px-2 py-1 text-xs ${statusStyle[project.data.status]}`}
              >
                {project.data.status}
              </span>
            </header>

            <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
              {project.data.summary}
            </p>

            {(project.data.before || project.data.after) && (
              <div class="mt-4 flex items-center gap-3 text-sm">
                <span class="text-gray-500 line-through decoration-gray-400">
                  {project.data.before}
                </span>
                <span aria-hidden="true" class="text-gray-400">→</span>
                <span class="font-semibold gradient-text">{project.data.after}</span>
              </div>
            )}

            {project.data.stack.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2 text-xs text-gray-500 dark:text-gray-400">
                {project.data.stack.map((item) => (
                  <li class="rounded-md border border-black/5 dark:border-white/10 px-2 py-1">
                    {item}
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/10 flex items-center gap-4 text-sm">
              <a href={`/automation/${project.slug}`} class="font-medium hover:underline">
                자세히 보기 →
              </a>
              {project.data.tool && (
                <a
                  href={project.data.tool.href}
                  class="text-gray-500 dark:text-gray-400 hover:underline"
                >
                  {project.data.tool.label}
                  {project.data.tool.gated && <span class="ml-1 text-xs">🔒</span>}
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- CTA -->
  <section data-reveal class="mt-16 text-center rounded-2xl p-10 border border-black/5 dark:border-white/10
                  bg-[linear-gradient(135deg,rgba(71,163,255,0.12),rgba(110,231,255,0.12))]">
    <h2 class="text-2xl font-bold">매주 반복하는 문서 작업이 있나요?</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      같은 틀에 내용만 바뀌는 일이라면 대부분 자동화할 수 있습니다.
    </p>
    <a href="/contact" class="mt-6 inline-block btn btn-primary">상담 요청</a>
  </section>
</BaseLayout>
