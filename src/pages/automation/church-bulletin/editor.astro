---
import BaseLayout from "../../../layouts/BaseLayout.astro";
export const prerender = true;
---

<BaseLayout
  title="예배자료 입력 | 이동수하우스"
  description="예배자료를 입력하면 주보·PPT 생성용 자료로 정리되고, 버킷에 저장·불러올 수 있습니다."
>
  <section class="relative overflow-hidden rounded-2xl border border-black/5 dark:border-white/10 p-10">
    <nav class="text-sm text-gray-500 dark:text-gray-400">
      <a href="/works" class="hover:underline">Works</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href="/works/church-bulletin" class="hover:underline">예원교회 주보 자동화</a>
    </nav>
    <h1 class="rise mt-4 text-3xl md:text-5xl font-extrabold leading-tight">
      <span class="gradient-text">예배자료 입력</span>
    </h1>
    <p class="mt-4 max-w-2xl text-gray-600 dark:text-gray-300">
      담당자별 입력을 모아 주보와 PPT 생성용 자료를 만듭니다. 저장한 자료는 다음 주에 불러와 재사용할 수 있습니다.
    </p>
  </section>

  <section class="mt-8">
    <div id="token-gate" class="card rounded-2xl max-w-md">
      <h2 class="font-semibold">토큰 입력</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">사용하려면 공유 토큰이 필요합니다.</p>
      <div class="mt-4 flex gap-2">
        <input id="token-input" type="password" placeholder="토큰"
               class="flex-1 rounded-lg border px-3 py-2 text-sm bg-white/80 dark:bg-white/5 dark:border-white/20" />
        <button id="token-submit" class="btn btn-primary">입장</button>
      </div>
      <p id="token-error" class="mt-2 text-sm text-red-500 hidden">토큰이 올바르지 않습니다.</p>
    </div>

    <div id="app-wrap" class="hidden grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
      <!-- 왼쪽: 상태 / 파일명 / 저장된 자료 -->
      <aside class="space-y-6">
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">제출 상태</h2>
          <div id="statusList" class="mt-3 space-y-2 text-sm"></div>
        </div>
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">검증 리포트</h2>
          <ul id="issues" class="mt-3 space-y-2 text-sm"></ul>
        </div>
        <div class="card rounded-2xl">
          <h2 class="text-sm font-semibold">파일명</h2>
          <div id="fileName" class="mt-2 text-sm font-mono text-gray-600 dark:text-gray-300"></div>
        </div>
        <div class="card rounded-2xl">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold">저장된 자료</h2>
            <button id="refreshBtn" class="text-xs underline text-gray-500">새로고침</button>
          </div>
          <ul id="savedList" class="mt-3 space-y-2 text-sm"></ul>
        </div>
      </aside>

      <!-- 가운데: 입력 폼 -->
      <main>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold">이번 주 예배자료</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">입력 → 저장 → 주보 생성 순서로 진행합니다.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="bulletinBtn" type="button" class="btn btn-ghost btn-sm">주보 만들기</button>
            <button id="saveBtn" type="button" class="btn btn-primary btn-sm">저장하기</button>
          </div>
        </div>
        <p id="saveStatus" class="mt-2 text-sm text-gray-500"></p>

        <form id="materialForm" class="mt-6 space-y-6">
          <section class="card rounded-2xl">
            <h3 class="font-semibold">예배 정보</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div>
                <label for="serviceDate" class="block text-xs text-gray-500 mb-1">예배 날짜</label>
                <input id="serviceDate" type="date" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="serviceType" class="block text-xs text-gray-500 mb-1">예배 종류</label>
                <select id="serviceType" class="w-full border rounded-lg px-3 py-2 text-sm">
                  <option>주일오전예배</option>
                  <option>수요예배</option>
                  <option>금요기도회</option>
                  <option>주일학교</option>
                </select>
              </div>
              <div>
                <label for="leader" class="block text-xs text-gray-500 mb-1">인도자 (표지)</label>
                <input id="leader" list="pastorList" placeholder="김삼열 목사" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="offeringPrayer" class="block text-xs text-gray-500 mb-1">헌금기도</label>
                <input id="offeringPrayer" list="pastorList" placeholder="김삼열 목사" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="prayer" class="block text-xs text-gray-500 mb-1">대표기도</label>
                <input id="prayer" placeholder="예: 김순규 장로" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="benediction" class="block text-xs text-gray-500 mb-1">축도</label>
                <input id="benediction" list="pastorList" placeholder="김삼열 목사" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
            </div>
            <datalist id="pastorList"><option value="김삼열 목사"></option></datalist>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">찬양팀</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div class="md:col-span-2 grid gap-2 md:grid-cols-2">
                <div>
                  <label for="praise1" class="block text-xs text-gray-500 mb-1">찬양 1</label>
                  <input id="praise1" list="songList" autocomplete="off" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label for="praise2" class="block text-xs text-gray-500 mb-1">찬양 2</label>
                  <input id="praise2" list="songList" autocomplete="off" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label for="praise3" class="block text-xs text-gray-500 mb-1">찬양 3</label>
                  <input id="praise3" list="songList" autocomplete="off" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                  <label for="praise4" class="block text-xs text-gray-500 mb-1">찬양 4</label>
                  <input id="praise4" list="songList" autocomplete="off" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <p class="md:col-span-2 text-xs text-gray-500">찬양PPT 폴더에 있는 악보 이름이 자동완성됩니다. 찬송가는 "270장" 처럼 장 번호로 적어도 됩니다.</p>
              </div>
              <div>
                <label for="offeringHymn" class="block text-xs text-gray-500 mb-1">찬송-2 / 봉헌찬송</label>
                <input id="offeringHymn" list="hymnList" autocomplete="off" placeholder="예: 43장 1절만" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="hymnThree" class="block text-xs text-gray-500 mb-1">찬송-3</label>
                <input id="hymnThree" list="hymnList" autocomplete="off" placeholder="예: 315장" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="hymnFour" class="block text-xs text-gray-500 mb-1">찬송-4</label>
                <input id="hymnFour" list="hymnList" autocomplete="off" placeholder="예: 288장" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div>
                <label for="specialSong" class="block text-xs text-gray-500 mb-1">특송</label>
                <select id="specialSong" class="w-full border rounded-lg px-3 py-2 text-sm">
                  <option value="remove">특송 슬라이드 제거</option>
                  <option value="keep">특송 있음</option>
                  <option value="none">확인 필요</option>
                </select>
              </div>
            </div>
            <datalist id="songList"></datalist>
            <datalist id="hymnList"></datalist>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">말씀</h3>
            <div class="mt-3 grid gap-4 md:grid-cols-2">
              <div>
                <label for="rrSelect" class="block text-xs text-gray-500 mb-1">교독문</label>
                <select id="rrSelect" class="w-full border rounded-lg px-3 py-2 text-sm">
                  <option value="">— 교독문 선택 —</option>
                </select>
                <input id="responsiveReading" type="hidden" />
                <p class="mt-1 text-xs text-gray-500">번호와 편이 함께 저장돼 PPT 생성 시 원본과 대조합니다.</p>
              </div>
              <div>
                <label for="scripture" class="block text-xs text-gray-500 mb-1">성경본문</label>
                <input id="scripture" placeholder="예: 고린도전서 13장 1-13절" class="w-full border rounded-lg px-3 py-2 text-sm" />
                <p class="mt-1 text-xs text-gray-500">"1절~13절", "14 ~ 33절" 어떻게 적어도 "1-13절"로 정리됩니다.</p>
              </div>
              <div class="md:col-span-2">
                <label for="sermonTitle" class="block text-xs text-gray-500 mb-1">설교 제목</label>
                <input id="sermonTitle" placeholder="예: 자유와 사랑" class="w-full border rounded-lg px-3 py-2 text-sm" />
              </div>
              <div class="md:col-span-2 rounded-lg border border-dashed px-4 py-3 text-xs text-gray-600 dark:text-gray-300 dark:border-white/20">
                <b>교독문·말씀봉독 슬라이드 서식은 고정입니다.</b>
                글자 44pt ·
                <span style="color:#0F172A;font-weight:600">홀수절 검정</span> ·
                <span style="color:#C2410C;font-weight:600">짝수절 주황</span> ·
                <span style="color:#B8860B;font-weight:600">마지막 절 황금</span> ·
                말씀봉독 마지막 절 끝에 (다같이).
                밝은 노랑 계열은 화면에서 보이지 않아 쓰지 않습니다. 바꿔야 하면 추가 요청란에 적어 주세요.
              </div>
            </div>
          </section>

          <section class="card rounded-2xl">
            <h3 class="font-semibold">광고</h3>
            <div class="mt-3 grid gap-4">
              <div>
                <label for="announcements" class="block text-xs text-gray-500 mb-1">광고 (한 줄에 하나씩)</label>
                <textarea id="announcements" rows="4" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
                <p class="mt-1 text-xs text-gray-500">첫 줄 환영 문구 → 안내 사항 → 기도 대상(이름 — 내용) 순으로 적으면 슬라이드 섹션으로 나뉩니다.</p>
              </div>
              <div>
                <label for="notes" class="block text-xs text-gray-500 mb-1">추가 요청</label>
                <textarea id="notes" rows="3" placeholder="PPT 수정 요청이나 방송실 전달사항" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
              </div>
            </div>
          </section>
        </form>
      </main>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    FIELDS,
    SAMPLE,
    EMPTY,
    buildMaterial,
    parseMaterialText,
    validate,
    dateStamp,
    fileNameFor,
    jsonFileNameFor,
    isJsonMaterial,
    dateFromFileName,
    formatResponsiveReading,
    normalizeScripture,
    applyDesignRule,
    lines,
    type MaterialData,
  } from "../../../lib/material";
  import kyodokmun from "../../../data/kyodokmun.json";
  import songs from "../../../data/songs.json";

  const TOKEN_KEY = "dshouse_editor_token";
  const DRAFT_KEY = "dshouse_bulletin_draft";

  const gate = document.getElementById("token-gate")!;
  const appWrap = document.getElementById("app-wrap")!;
  const tokenInput = document.getElementById("token-input") as HTMLInputElement;
  const tokenSubmit = document.getElementById("token-submit")!;
  const tokenError = document.getElementById("token-error")!;
  const saveStatus = document.getElementById("saveStatus")!;
  const savedList = document.getElementById("savedList")!;

  let token = sessionStorage.getItem(TOKEN_KEY) || "";

  function el(id: string) {
    return document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  }

  /** 폼 → 데이터 객체 */
  function formData(): MaterialData {
    const data = { ...EMPTY };
    FIELDS.forEach((id) => {
      const node = el(id);
      if (node) data[id] = node.value;
    });
    // 찬양 4칸 → 줄바꿈 목록
    data.praiseMain = [1, 2, 3, 4]
      .map((n) => (el(`praise${n}`)?.value ?? "").trim())
      .filter(Boolean)
      .join("\n");
    // 교독문 select("65|시편 149편") → "교독문 65. 시편 149편"
    const rr = el("rrSelect")?.value ?? "";
    data.responsiveReading = rr ? formatResponsiveReading(rr) : data.responsiveReading;
    data.scripture = normalizeScripture(data.scripture);
    return applyDesignRule(data);
  }

  /** 데이터 객체 → 폼 */
  function applyData(data: Partial<MaterialData>) {
    const normalized = applyDesignRule({ ...EMPTY, ...data });
    Object.entries(normalized).forEach(([id, value]) => {
      const node = el(id);
      if (node) node.value = value ?? "";
    });
    const praise = lines(normalized.praiseMain).map((l) => l.replace(/^(\d+\.\s*)+/, ""));
    [1, 2, 3, 4].forEach((n) => {
      const node = el(`praise${n}`);
      if (node) node.value = praise[n - 1] ?? "";
    });
    // "교독문 65. 시편 149편" → select 값
    const m = (normalized.responsiveReading ?? "").match(/(\d{1,3})\./);
    const sel = el("rrSelect") as HTMLSelectElement | null;
    if (sel) {
      const no = m ? Number(m[1]) : 0;
      const opt = [...sel.options].find((o) => o.value.startsWith(`${no}|`));
      sel.value = opt ? opt.value : "";
    }
    render();
  }

  /** 교독문·곡 목록을 select/datalist에 채운다 (한 번만). */
  function fillLists() {
    const sel = el("rrSelect") as HTMLSelectElement;
    if (sel && sel.options.length <= 1) {
      (kyodokmun as { no: number; title: string; verses: number }[]).forEach((k) => {
        const o = document.createElement("option");
        o.value = `${k.no}|${k.title}`;
        o.textContent = `${k.no}. ${k.title} (${k.verses}절)`;
        sel.appendChild(o);
      });
    }
    const songList = document.getElementById("songList");
    const hymnList = document.getElementById("hymnList");
    const data = songs as { hymns: { no: number; title: string }[]; ccm: string[] };
    if (songList && !songList.children.length) {
      data.hymns.forEach((h) => {
        const o = document.createElement("option");
        o.value = `${h.no}장 ${h.title}`;
        songList.appendChild(o);
      });
      data.ccm.forEach((t) => {
        const o = document.createElement("option");
        o.value = t;
        songList.appendChild(o);
      });
    }
    if (hymnList && !hymnList.children.length) {
      data.hymns.forEach((h) => {
        const o = document.createElement("option");
        o.value = `${h.no}장`;
        o.label = h.title;
        hymnList.appendChild(o);
      });
    }
  }

  function updateStatus(data: MaterialData) {
    const groups: [string, boolean][] = [
      ["찬양팀", Boolean(data.praiseMain && data.offeringHymn && data.hymnThree && data.hymnFour)],
      ["예배순서", Boolean(data.responsiveReading && data.prayer)],
      ["말씀/설교", Boolean(data.scripture && data.sermonTitle)],
      ["광고", Boolean(data.announcements)],
      ["검증", !validate(data).some(([level]) => level === "danger")],
    ];
    el("statusList").innerHTML = groups
      .map(([label, done]) => {
        const dotClass = done ? "bg-emerald-500" : "bg-amber-400";
        const state = done ? "완료" : "대기";
        return `<div class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full ${dotClass}"></span><span>${label} · ${state}</span></div>`;
      })
      .join("");
  }

  function render() {
    const data = formData();
    el("fileName").textContent = fileNameFor(data.serviceDate);
    el("issues").innerHTML = validate(data)
      .map(([level, text]) => {
        const color =
          level === "danger" ? "text-red-500" : level === "warn" ? "text-amber-500" : "text-emerald-600";
        return `<li class="${color}">${text}</li>`;
      })
      .join("");
    updateStatus(data);
  }

  function loadSample() {
    applyData(SAMPLE);
  }

  // --- 버킷 연동 ---
  function showGate(message?: string) {
    sessionStorage.removeItem(TOKEN_KEY);
    token = "";
    appWrap.classList.add("hidden");
    gate.classList.remove("hidden");
    if (message) {
      tokenError.textContent = message;
      tokenError.classList.remove("hidden");
    }
  }

  async function authedFetch(input: string, init: RequestInit = {}) {
    const res = await fetch(input, {
      ...init,
      headers: { ...(init.headers || {}), "x-editor-token": token },
    });
    if (res.status === 401) {
      showGate("토큰이 올바르지 않습니다.");
      throw new Error("unauthorized");
    }
    return res;
  }

  async function loadBucketList() {
    savedList.innerHTML = '<li class="text-gray-500">불러오는 중…</li>';
    const res = await authedFetch("/api/bucket-list");
    // .json 쌍둥이 파일은 자동화용이라 목록에서 숨긴다 (불러올 때 알아서 우선 사용)
    const items = ((await res.json()) as { name: string; savedAt?: string }[]).filter(
      (item) => !isJsonMaterial(item.name),
    );
    if (!items.length) {
      savedList.innerHTML = '<li class="text-gray-500">저장된 자료가 없습니다.</li>';
      return items;
    }
    savedList.innerHTML = "";
    for (const item of items) {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className =
        "w-full text-left rounded-lg border px-3 py-2 text-xs hover:bg-black/5 dark:hover:bg-white/10 dark:border-white/20";
      const savedAt = item.savedAt ? new Date(item.savedAt).toLocaleString("ko-KR") : "";
      btn.innerHTML = `<div class="font-medium">${item.name}</div><div class="text-gray-500">${savedAt}</div>`;
      btn.addEventListener("click", () => loadFromBucket(item.name));
      li.appendChild(btn);
      savedList.appendChild(li);
    }
    return items;
  }

  async function loadInitial() {
    const items = await loadBucketList();
    if (items.length) {
      await loadFromBucket(items[0].name);
    } else {
      loadSample();
    }
  }

  async function loadFromBucket(name: string) {
    saveStatus.textContent = "불러오는 중…";
    const date = dateFromFileName(name);

    // 1) .json 쌍둥이가 있으면 그대로 복원 (정규식 파싱 없이 정확)
    if (date) {
      const jsonRes = await authedFetch(
        `/api/bucket-file?name=${encodeURIComponent(jsonFileNameFor(date))}`,
      ).catch(() => null);
      if (jsonRes?.ok) {
        try {
          const data = (await jsonRes.json()) as Partial<MaterialData>;
          applyData({ ...EMPTY, ...data, serviceDate: date });
          saveStatus.textContent = `"${name}" 불러옴 (json)`;
          return;
        } catch {
          /* json이 깨졌으면 txt로 폴백 */
        }
      }
    }

    // 2) txt만 있는 예전 자료
    const res = await authedFetch(`/api/bucket-file?name=${encodeURIComponent(name)}`);
    if (!res.ok) {
      saveStatus.textContent = "불러오기 실패";
      return;
    }
    const text = await res.text();
    const parsed = parseMaterialText(text, formData());
    if (date) parsed.serviceDate = date;
    applyData(parsed);
    saveStatus.textContent = `"${name}" 불러옴`;
  }

  async function saveToBucket() {
    const data = formData();
    if (!dateStamp(data.serviceDate)) {
      saveStatus.textContent = "예배 날짜를 먼저 선택하세요.";
      return;
    }
    const name = fileNameFor(data.serviceDate);
    const jsonName = jsonFileNameFor(data.serviceDate);
    saveStatus.textContent = "저장 중…";

    // txt: 사람이 읽고 주보 인쇄에 사용
    const res = await authedFetch("/api/bucket-file", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, content: buildMaterial(data) }),
    });
    if (!res.ok) {
      saveStatus.textContent = "저장 실패";
      return;
    }

    // json: PPT 자동화가 읽는 원본 구조 (파싱 오류 원천 차단)
    const jsonRes = await authedFetch("/api/bucket-file", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name: jsonName, content: JSON.stringify(data, null, 2) }),
    });
    if (!jsonRes.ok) {
      saveStatus.textContent = `"${name}" 저장됨 · json 저장 실패`;
      loadBucketList();
      return;
    }

    saveStatus.textContent = `"${name}" + json 저장됨`;
    loadBucketList();
  }

  /** 주보 인쇄뷰 열기 — 현재 입력값을 그대로 넘깁니다(저장 여부와 무관). */
  function openBulletin() {
    const data = formData();
    if (!dateStamp(data.serviceDate)) {
      saveStatus.textContent = "예배 날짜를 먼저 선택하세요.";
      return;
    }
    if (validate(data).some(([level]) => level === "danger")) {
      saveStatus.textContent = "검증 리포트의 빨간 항목을 먼저 확인하세요. 그래도 미리보기는 열립니다.";
    }
    sessionStorage.setItem(DRAFT_KEY, JSON.stringify(data));
    window.open(`/automation/church-bulletin/print?date=${data.serviceDate}`, "_blank");
  }

  // --- 이벤트 바인딩 ---
  fillLists();
  [...FIELDS, "praise1", "praise2", "praise3", "praise4", "rrSelect"].forEach((id) => {
    const node = el(id);
    if (!node) return;
    node.addEventListener("input", render);
    node.addEventListener("change", render);
  });

  document.getElementById("saveBtn")!.addEventListener("click", saveToBucket);
  document.getElementById("bulletinBtn")!.addEventListener("click", openBulletin);
  document.getElementById("refreshBtn")!.addEventListener("click", loadBucketList);

  el("serviceDate").addEventListener("click", (e) => {
    const target = e.target as HTMLInputElement & { showPicker?: () => void };
    if (typeof target.showPicker === "function") target.showPicker();
  });

  tokenSubmit.addEventListener("click", async () => {
    token = tokenInput.value.trim();
    if (!token) return;
    sessionStorage.setItem(TOKEN_KEY, token);
    tokenError.classList.add("hidden");
    gate.classList.add("hidden");
    appWrap.classList.remove("hidden");
    await loadInitial();
  });

  tokenInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") tokenSubmit.dispatchEvent(new Event("click"));
  });

  if (token) {
    gate.classList.add("hidden");
    appWrap.classList.remove("hidden");
    loadInitial();
  } else {
    loadSample();
  }
</script>
